# Local use: shows an explicitly labeled development-only OTP in the login screen.
PR_MENTOR_ENV=development
PR_MENTOR_OTP_MODE=demo

# API configuration (demo works without external services)
APP_NAME=PR Mentor API
APP_ENV=development
DEBUG=false
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true

# Optional GitHub API access (public PRs work without a token; authenticated access has higher limits)
GITHUB_TOKEN=

# Optional MongoDB persistence
MONGODB_URI=
MONGODB_DATABASE=pr_mentor

# Optional OpenAI-compatible LLM endpoint
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=

# Real email delivery: set PR_MENTOR_OTP_MODE=smtp and configure:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=PR Mentor <no-reply@example.com>

# Real SMS delivery: set PR_MENTOR_OTP_MODE=twilio and configure:
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...  (or TWILIO_FROM_NUMBER=+1...)
