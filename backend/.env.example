# Optional GitHub token raises API rate limits. Never commit a real token.
GITHUB_TOKEN=

# Optional OpenAI-compatible provider. Without both values AI is reported unavailable.
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions

# Select sqlite (default) or mongodb. MongoDB failures never fall back to SQLite.
PR_MENTOR_STORAGE=sqlite

# MongoDB is used only when PR_MENTOR_STORAGE=mongodb. Keep credentials out of source control.
MONGODB_URI=
MONGODB_DATABASE=pr_mentor

# SQLite local/test storage; relative paths resolve from the backend working directory.
PR_MENTOR_DATABASE_PATH=./data/pr_mentor.sqlite3

# Comma-separated browser origins allowed to call this API.
PR_MENTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PR_MENTOR_HTTP_TIMEOUT=15
